# Copia este archivo a .env y completa los valores de tu proyecto.
# Supabase Dashboard → Project Settings → API
#
# Usa únicamente las claves públicas.
# Nunca coloques SUPABASE_SERVICE_ROLE_KEY en este archivo ni en el frontend.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
